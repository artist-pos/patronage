NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Service role key — NEVER expose client-side. Required for account deletion.
# Found in Supabase Dashboard → Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Site URL — used in digest emails (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://patronage.nz

# Resend — optional, enables the "Send digest" button in /admin/digest
# Get a free API key at https://resend.com
RESEND_API_KEY=re_your-resend-api-key
# Must be a verified sender domain in your Resend account
RESEND_FROM=Patronage <digest@patronage.nz>
# Signing secret for the Resend event webhook (Settings -> Webhooks).
# Needed by /api/webhooks/resend to record digest opens and clicks in PostHog.
RESEND_WEBHOOK_SECRET=whsec_your-resend-webhook-secret

# Cron secret — required by /api/cron/* routes and /api/admin/send-digest (GET)
# Generate with: openssl rand -hex 32
CRON_SECRET=your-cron-secret

# Claude API — used by /api/parse-opportunity
ANTHROPIC_API_KEY=your-anthropic-api-key

STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret

# PostHog — product analytics. The app calls posthog.init() unconditionally, so
# a missing key throws on first client render.
# Project settings → Project API key
NEXT_PUBLIC_POSTHOG_KEY=phc_your-posthog-project-key
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Cloudflare Turnstile — CAPTCHA on signup, the partner activation-enquiry
# forms, and the bug report form. Without these set, those forms skip the
# captcha check entirely (rate limiting + honeypot still apply).
# Create a widget at https://dash.cloudflare.com/?to=/:account/turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x_your-turnstile-site-key
TURNSTILE_SECRET_KEY=0x_your-turnstile-secret-key
