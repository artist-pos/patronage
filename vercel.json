{
  "regions": ["syd1"],
  "env": {
    "NEXT_PUBLIC_SITE_URL": "https://patronage.nz"
  },
  "crons": [
    {
      "path": "/api/admin/send-digest",
      "schedule": "30 20 * * 2"
    },
    {
      "path": "/api/cron/send-followups",
      "schedule": "0 20 * * *"
    },
    {
      "path": "/api/cron/send-update-reminders",
      "schedule": "15 20 * * *"
    },
    {
      "path": "/api/cron/send-application-summary",
      "schedule": "30 19 * * *"
    }
  ]
}
